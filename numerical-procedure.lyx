\begin_layout Subsection
Setting up the ODE for the Numerical Solution
\end_layout

\begin_layout Subsubsection
ODE for the Flow of the Adimensionless Potential
\end_layout

\begin_layout Standard
One starts by considering the flow equation at the phase transition,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:1"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
0=-d\tilde{U}_{t}+\left(d-s+\eta\right)\tilde{\rho}\tilde{U}_{t}^{\left(1\right)}+\frac{A_{d}\frac{s}{2}\left(1-\frac{\eta}{s+d}\right)}{1+\tilde{U}_{t}^{\left(1\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}}\label{eq:1}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The prefactors in the last term can be removed by using the identities,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:2"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\tilde{\rho}^{\prime}=\xi\tilde{\rho} & \text{ ; } & \tilde{U}_{t}^{\prime} & =\xi\tilde{U}_{t}\text{ ; } & \xi^{-1} & =A_{d}\frac{s}{2}\left(1-\frac{\eta}{s+d}\right)\label{eq:2}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Namely,
 one notices Eqs.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:3"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\frac{\partial\tilde{U}_{t}}{\partial\tilde{\rho}} & =\xi^{-1}\frac{\partial\tilde{\rho}^{\prime}}{\partial\tilde{\rho}}\frac{\partial\tilde{U}_{t}^{\prime}}{\partial\tilde{\rho}^{\prime}}=\frac{\partial\tilde{U}_{t}^{\prime}}{\partial\tilde{\rho}^{\prime}}\text{ ; } & \frac{\partial^{2}\tilde{U}_{t}}{\partial\tilde{\rho}^{2}} & =\frac{\partial\tilde{\rho}^{\prime}}{\partial\tilde{\rho}}\frac{\partial^{2}\tilde{U}_{t}^{\prime}}{\partial\tilde{\rho}^{\prime2}}=\xi\frac{\partial^{2}\tilde{U}_{t}^{\prime}}{\partial\tilde{\rho}^{\prime2}}\label{eq:3}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Which reduce Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:1"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) onto Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:4"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
0=-d\tilde{U}_{t}+\left(d-s+\eta\right)\tilde{\rho}\tilde{U}_{t}^{\left(1\right)}+\frac{1}{1+\tilde{U}_{t}^{\left(1\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}}\label{eq:4}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
By inverting Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:4"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 one obtains Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:5"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\tilde{U}_{t}^{\left(2\right)}=-\frac{1}{2\tilde{\rho}}\left(1+\tilde{U}_{t}^{\left(1\right)}+\frac{1}{-d\tilde{U}_{t}+\left(d-s+\eta\right)\tilde{\rho}\tilde{U}_{t}^{\left(1\right)}}\right)\label{eq:5}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Satisfying the initial conditions,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:6"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\tilde{U}_{t}^{\left(1\right)}\left(\tilde{\rho}=0\right) & =\sigma\text{ ; } & \tilde{U}_{t}\left(\tilde{\rho}=0\right) & =\frac{1}{d\left(1+\sigma\right)}\label{eq:6}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
In practice,
 this equation is,
 however,
 not very convenient for numerical integrations.
 This is because the denominator inside the parenthesis in Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:5"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) introduces a non-physical boundary when the denominator tends to zero,
 which may lead to numerical instabilities.
 By instead diferentiating Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:1"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) with respect to 
\begin_inset Formula $\tilde{\rho}$
\end_inset

,
 one obtains Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:7"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
0=\left(-s+\eta\right)\tilde{U}_{t}^{\left(1\right)}+\left(d-s+\eta\right)\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}-\frac{3\tilde{U}_{t}^{\left(2\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(3\right)}}{\left(1+\tilde{U}_{t}^{\left(1\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}\right)^{2}}\label{eq:7}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
That is,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:8"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\tilde{U}_{t}^{\left(3\right)}=\frac{1}{2\tilde{\rho}}\left\{ \left(1+\tilde{U}_{t}^{\left(1\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}\right)^{2}\left[\left(-s+\eta\right)\tilde{U}_{t}^{\left(1\right)}+\left(d-s+\eta\right)\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}\right]-3\tilde{U}_{t}^{\left(2\right)}\right\} \label{eq:8}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The initial conditions are correspondingly given by Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:8.1"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\tilde{U}_{t}^{\left(1\right)}\left(\tilde{\rho}=0\right) & =\sigma\text{ ; } & \tilde{U}_{t}^{\left(2\right)}\left(\tilde{\rho}=0\right) & =\frac{\left(-s+\eta\right)\left(1+\sigma\right)^{2}\sigma}{3}\label{eq:8.1}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Eventually,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:8"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) reaches an asymptotic state,
 where the denominator term goes to infinity and the third term vanishes.
 In this case,
 the equation can be solved analytically to Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:9"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 where 
\begin_inset Formula $\tilde{\rho}_{\infty}$
\end_inset

 is the field from which the asymptotic equation becomes valid,and 
\begin_inset Formula $\tilde{\rho}>\tilde{\rho}_{\infty}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\tilde{U}_{t}\left(\tilde{\rho}\right)=\tilde{U}_{t}\left(\tilde{\rho}_{\infty}\right)\left(\frac{\tilde{\rho}}{\tilde{\rho}_{\infty}}\right)^{\frac{d}{d-s+\eta}}\label{eq:9}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Finally,
 by remembering that 
\begin_inset Formula $\tilde{\rho}=\frac{1}{2}\tilde{\phi}^{2}$
\end_inset

,
 it is possible to instead consider solutions in terms of Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:10"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 The solutions in this case are simiar,
 except that the initial condition is affixated by 
\begin_inset Formula $\tilde{U}_{t}^{\left(2\right)}\left(\tilde{\phi}=0\right)=\sigma$
\end_inset

 instead.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
0=-d\tilde{U}_{t}+\frac{\left(d-s+\eta\right)}{2}\tilde{\phi}\tilde{U}_{t}^{\left(1\right)}+\frac{A_{d}\frac{s}{2}\left(1-\frac{\eta}{s+d}\right)}{1+\tilde{U}_{t}^{\left(2\right)}}\label{eq:10}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Out of the possibilities above,
 we noticed best numerical stability by using Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:8"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) and the initial condition,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:8.1"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 Furthermore,
 the identification of a threshold 
\begin_inset Formula $\tilde{\rho}_{\infty}$
\end_inset

 and the replacement of the numerical solution by the analytical solution,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:9"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 for all 
\begin_inset Formula $\tilde{\rho}>\tilde{\rho}_{\infty}$
\end_inset

,
 led to significantly improved numerical stability,
 particularly for the calculation of the RG eigenvalues.
\end_layout

\begin_layout Subsubsection
ODE for the RG Eigenvectors
\end_layout

\begin_layout Standard
One considers an infinitesimal perturbation in the vicinity of the fixed point,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:10"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 with 
\begin_inset Formula $\varepsilon\to0$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\tilde{U}_{t}=\varepsilon\tilde{\nu}\left(y,\tilde{\rho}\right)e^{-yt}\label{eq:11}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
By substituting Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:11"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) onto Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:8"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) and taylor expanding the denominator to the first order in 
\begin_inset Formula $\varepsilon,$
\end_inset

one obtains Eqs.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:12"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

,
 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:13"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
0 & =-\left(-y+d\right)\tilde{\nu}+\left(d-s+\eta\right)\tilde{\rho}\tilde{\nu}^{\left(1\right)}-\frac{\tilde{\nu}^{\left(1\right)}+2\tilde{\rho}\tilde{\nu}^{\left(2\right)}}{\left(1+\tilde{U}_{t}^{\left(1\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}\right)^{2}}\label{eq:12}\\
\tilde{\nu}^{\left(2\right)} & =-\frac{1}{2\tilde{\rho}}\left\{ \left(1+\tilde{U}_{t}^{\left(1\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}\right)^{2}\left[\left(-y+d\right)\tilde{\nu}-\left(d-s+\eta\right)\tilde{\rho}\tilde{\nu}^{\left(1\right)}\right]+\tilde{\nu}^{\left(1\right)}\right\} \label{eq:13}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\tilde{\nu}$
\end_inset

 is a degree of freedom,
 one may choose the initial conditions,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:14"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\tilde{\nu}\left(\tilde{\rho}=0\right) & =1\text{ ; } & \tilde{\nu}^{\left(1\right)}\left(\tilde{\rho}=0\right) & =\left(1+\sigma\right)^{2}\left(d-y\right)\label{eq:14}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:13"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) also has an asymptotic solution,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:15"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 Although this is not directly used for the purposes of the numerical integration described in this paper,
 it could in theory lead to an improvement in numerical results.
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\tilde{\nu}\left(\tilde{\rho}\right)=\tilde{\nu}\left(\tilde{\rho}_{\infty}\right)\left(\frac{\tilde{\rho}}{\tilde{\rho}_{\infty}}\right)^{\frac{-y+d}{d-s+\eta}}\label{eq:15}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Simulated Annealing
\end_layout

\begin_layout Standard
As a first step,
 one must find the parameters 
\begin_inset Formula $\left(\sigma,\eta\right)$
\end_inset

 for which the potential,
 Eq.
 (),
 is (or at the very least appears to be) analytical.
 Those results correspond to possible phase transitions that would therefore warrant further investigation.
 For cases where the anomalous dimension is already known,
 a simple grid search over possible values of 
\begin_inset Formula $\sigma$
\end_inset

 appears to be an efficient solution.
 On the other hand,
 when 
\begin_inset Formula $\eta$
\end_inset

 is also unknown,
 the following main problems emerge:
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\eta$
\end_inset

 is not a free variable,
 but it is rather dependant on 
\begin_inset Formula $\sigma,$
\end_inset

that is to say,
 
\begin_inset Formula $\eta=\eta$
\end_inset


\begin_inset Formula $\left(\sigma\right)$
\end_inset

.
 This means that,
 in practice,
 most of the solutions for 
\begin_inset Formula $\left(\sigma,\eta\right)$
\end_inset

,
 were 
\begin_inset Formula $\eta$
\end_inset

 to be treated as an independent variable,
 are actually spurious solutions and do not represent actual,
 physical phase transitions.
 
\end_layout

\begin_layout Enumerate
It appears that a possible solution would be to choose some values 
\begin_inset Formula $\left(\sigma,\eta\right)$
\end_inset

,
 integrate the potential,
 and self-consistently re-calculate 
\begin_inset Formula $\eta$
\end_inset

 based on the numerically-integrated trajectory for the potential.
 On the other hand,
 unless 
\begin_inset Formula $\left(\sigma,\eta\right)$
\end_inset

 is already sufficiently close to a physical solution,
 there is no guarantee that a re-caluclation of 
\begin_inset Formula $\eta$
\end_inset

 will at all ensure that the system converges.
 Furthemore,
 if more than a single meta-stable solution exists,
 one runs onto the risk of failing to capture all possible solutions.
 
\end_layout

\begin_layout Enumerate
Finally,
 a grid search over all parameters 
\begin_inset Formula $\left(\sigma,\eta\right)$
\end_inset

 is generally unrealistic due to the computational overhead.
 In practice,
 a more efficient method is required,
 at least in order to detect the
\shape italic
 general region
\shape default
 where the solution-space lays,
 such that a grid search can then be used within this region only.
 
\end_layout

\begin_layout Enumerate
Even if a reduced solution-space can be found,
 as described in (3) above,
 one is still not guaranteed to find good solutions with a grid search,
 because the solution space may be (in fact,
 it is) significantly stiff.
\end_layout

\begin_layout Standard
From numerical simulations realized in connection with this thesis,
 a reliable solution that addresses the issues described above appears to consist of implementing a monte-carlo-simulated-annealing algoritm to conduct the grid search.
 Essentially,
 one defines a 
\begin_inset Quotes eld
\end_inset

temperature
\begin_inset Quotes erd
\end_inset

 variable that decays according toa cooling rate,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:16"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 For each simulation:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
T=-\kappa Tdt\label{eq:16}
\end{equation}

\end_inset


\end_layout

\begin_layout Enumerate
Choose 
\begin_inset Formula $\left(\sigma,\eta\right)$
\end_inset

 at random.
 
\end_layout

\begin_layout Enumerate
Integrate the potential 
\begin_inset Formula $\tilde{U}_{t}\left(\tilde{\rho},\sigma,\eta\right)$
\end_inset

,
 find the threshold 
\begin_inset Formula $\tilde{\rho}_{\infty}^{\left(\sigma,\eta\right)}$
\end_inset

 for which the numerical solution diverges.
 Furthermore,
 potentially re-calculate 
\begin_inset Formula $\eta_{new}$
\end_inset

 self-consistently,
 given the calcualted trajectory 
\begin_inset Formula $\tilde{U}_{t}\left(\tilde{\rho},\sigma,\eta\right)$
\end_inset

.
 Potentially recalculate 
\begin_inset Formula $\eta_{new}$
\end_inset

 as many times as necessary to ensure convergence or up until a maximum number of iterations.
\end_layout

\begin_layout Enumerate
Compare with previous iteration,
 Eq.
 (),
 where the index 
\begin_inset Formula $i$
\end_inset

 indicates the iteration number.
 
\end_layout

\begin_layout Enumerate
Accept all configurations that improve the threshold.
 If threshold is worsened,
 accept or reject the new configuration based on an exponental probability 
\begin_inset Formula $P\sim e^{-\Delta_{i}T}$
\end_inset

,
 where 
\begin_inset Formula $T$
\end_inset

 is the temperature.
 
\end_layout

\begin_layout Enumerate
Update the temperature,
 based on the cooling rate,
 by means of Eq .(
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:16"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\Delta_{i}=-\frac{\tilde{\rho}_{\infty,i}^{\left(\sigma,\eta\right)}-\tilde{\rho}_{\infty,i-1}^{\left(\sigma,\eta\right)}}{\tilde{\rho}_{\infty,i}^{\left(\sigma,\eta\right)}}\label{eq:16.1}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
As a general strategy,
 one begins with a strong cooling rate,
 
\begin_inset Formula $\kappa>>0$
\end_inset

,
 and a small number of iterations,
 
\begin_inset Formula $i_{max}<<\infty$
\end_inset

.
 The algorithm is re-initialized at multiple values of 
\begin_inset Formula $\left(\sigma,\eta\right)$
\end_inset

.
 This ensures that,
 at first instance,
 the algorithm will explore a broad region of the solution space and,
 accordingly,
 identify many local maxima for the asymptotic field,
 that is,
 many regions where phase transitions may occur.
 Once those portions are identified,
 a second annealing phase is executed,
 in order to properly characterize those regions of local maxima,
 and to identify the exact point corresponding to the phase transtion in such vicinity.
 For this second annealing phase,
 a much smaller cooling rate is chosen,
 
\begin_inset Formula $\kappa\to0$
\end_inset

,
 and respectively 
\begin_inset Formula $i_{max}>>0$
\end_inset

.
 This ensures that the correct maxima is identified.
 A subsequent grid search in the 
\begin_inset Quotes eld
\end_inset

infinitesimal
\begin_inset Quotes erd
\end_inset

 region near the located maxima may be executed,
 to guarantee even further convergence.
 If this approach is chosen,
 it is important to ensure (1) that the point itself where the annealing predicted the maxima belongs to the grid;
 and (2) that the search window gets subsequently 
\begin_inset Quotes eld
\end_inset

zoomed-in
\begin_inset Quotes erd
\end_inset

 in order to improve decimal point accuracy.
 
\end_layout

\begin_layout Standard
An important remark to emphasize is that,
 whilst in the first annealing phase,
 the value of the anomalous dimension is fixed by 
\begin_inset Formula $\sigma$
\end_inset

 (that is,
 the result is self-consistently re-calculated),
 in the second annealing phase,
 one allows 
\begin_inset Formula $\eta$
\end_inset

 to be a free-floating parameter.
 This is justified on the basis that (1) within an attraction basin,
 the maxima is clearly distinguishable by a unique choice of 
\begin_inset Formula $\left(\sigma,\eta\right)$
\end_inset

 (this statement is based on the visual observation of the graphs);
 and (2) therefore it makes sense to let the anomalous dimension float freely in this vicinity,
 in order to remove the effect of numerical artifacts induced to the anomalous dimension calculation by the numerical integration of the potential.
 
\end_layout

\begin_layout Subsection
Effective dimension approach
\end_layout

\begin_layout Standard
It appears that,
 to first order,
 long-ranged models can be related to respective short-ranged models by means of the transformation,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:17"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
D_{eff}=\frac{d}{s}\left(2-\eta\left(D_{eff}\right)\right)\label{eq:17}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Namely,
 starting from Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:18"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 one obtains Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:18"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
0 & =-D_{eff}\tilde{U}_{t}+\left(D_{eff}-2+\eta\right)\tilde{\rho}\tilde{U}_{t}^{\left(1\right)}+\left(1-\frac{\eta}{D_{eff}+2}\right)\left(1+\tilde{U}_{t}^{\left(1\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}\right)^{-1}\label{eq:18}\\
0 & =-d\tilde{U}_{t}+\left(2-s\right)\tilde{\rho}\tilde{U}_{t}^{\left(1\right)}+\frac{s}{2}\left(\frac{1}{1-\frac{\eta}{2}}\right)\left(1-\frac{\eta}{D_{eff}+2}\right)\left(1+\tilde{U}_{t}^{\left(1\right)}+2\tilde{\rho}\tilde{U}_{t}^{\left(2\right)}\right)^{-1}\label{eq:19}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
In the least extreme case,
 
\begin_inset Formula $D_{eff}\to\infty$
\end_inset

 when 
\begin_inset Formula $s\to0$
\end_inset

.
 In this case,
 
\begin_inset Formula $\eta\left(D_{eff}\right)\to0$
\end_inset

 since the anomalous dimension tends to drop with dimensionality,
 being always zero for 
\begin_inset Formula $d\geq4$
\end_inset

 (at least for scalar theories).
 But when 
\begin_inset Formula $\eta=0$
\end_inset

,
 the residual terms inside the parenthesis become exactly equal to one,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:20"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\left(\frac{1}{1-\frac{\eta}{2}}\right)\left(1-\frac{\eta}{D_{eff}+2}\right)=1\label{eq:20}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The effective dimension approach is therefore 
\bar under
exact
\bar default
 for 
\begin_inset Formula $d\geq4$
\end_inset

,
 and it is expected to reproduce fairly accurate results for 
\begin_inset Formula $d\lesssim4$
\end_inset

,
 since in this limit 
\begin_inset Formula $\eta$
\end_inset

 is small and the residual terms vanish almost.
 On the other hand,
 the most extreme case occurs when 
\begin_inset Formula $D_{eff}\to d$
\end_inset

.
 In this case,
 for the bi-critical model in 
\begin_inset Formula $d=2$
\end_inset

,
 which (from CFT) one expects to dispose of the greatest anomalous dimension,
 
\begin_inset Formula $\eta=0.25$
\end_inset

,
 one obtains 
\begin_inset Formula $s=2-\eta$
\end_inset

 and the residual term,
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:21"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 In other words,
 
\begin_inset Formula $D_{eff}\to d$
\end_inset

 corresponds to the Sak Point 
\begin_inset Formula $s^{\star}=2-\eta$
\end_inset

,
 and in this limit the residual coefficients in the third term of Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:19"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) report an error of around 
\begin_inset Formula $7\%$
\end_inset

 in relation to the long-ranged equation.
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\left(\frac{1}{1-\frac{\eta}{2}}\right)\left(1-\frac{\eta}{D_{eff}+2}\right)\approx1.07\label{eq:21}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Because the Ansatz truncation lacks a characteristic stopping point,
 
\end_layout

\begin_layout Subsection
Simulation Configurations
\end_layout

\begin_layout Standard
Due to computational limitations that arise in the context of numerical computation,
 artifacts must be introduced to the numerical implementation,
 in order to ensure stability.
 
\end_layout

\begin_layout Itemize
The asymptotic field is integrated to,
 at most,
 
\begin_inset Formula $\tilde{\rho}_{\infty}=2000$
\end_inset

 units.
 If a trajectory is integrated up to this value,
 the trajectory is treated as if it had converged.
\end_layout

\begin_layout Itemize
The asymptotic field is integrated starting from 
\begin_inset Formula $\tilde{\rho}_{0}=10^{-6}$
\end_inset

 units (as opposed to 
\begin_inset Formula $\tilde{\rho}_{0}=0$
\end_inset

 units),
 and it is integrated in 
\begin_inset Quotes eld
\end_inset

inifinitesimal
\begin_inset Quotes erd
\end_inset

 of 
\begin_inset Formula $\Delta\tilde{\rho}=10^{-6}$
\end_inset

 using a 
\family typewriter
runge_kutta_fehlberg78
\family default
 integrator from the C++ library 
\family typewriter
boost/numeric/odeint.hpp
\family default
.
 Both the tolerance and the absolute tolerances are set to 
\begin_inset Formula $10^{-10}$
\end_inset

,
 and the algorithm implements adaptative steps,
 such that,
 if the convergence fails,
 step sizes are reduced by 
\begin_inset Formula $0.5$
\end_inset

 units per iteration,
 up to 
\begin_inset Formula $\Delta\tilde{\rho}_{max}=10^{-8}$
\end_inset

 units.
 The grid is afterwards relaxed by a Hermite interpolation algorithm,
 such that a homogenous grid with 
\begin_inset Formula $8'000$
\end_inset

 steps is ultimately sampled.
 
\end_layout

\begin_layout Itemize
For the cases where the anomalous dimension is self-consistently recalculated,
 
\begin_inset Formula $100$
\end_inset

 re-calculations at most are allowed,
 with a convergence criteria 
\begin_inset Formula $\left|\eta_{old}-\eta_{new}\right|\leq10^{-4}$
\end_inset

.
 Furthermore,
 the anomalous dimension is updated by Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:damping"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 where the damping is set to 
\begin_inset Formula $\delta=0.05$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\eta_{new}=\delta\times\eta_{old}+\left(1-\delta\right)\times\eta_{recalculated}\label{eq:damping}
\end{equation}

\end_inset


\end_layout

\begin_layout Itemize
For cases where a grid search is implemented,
 the grid search is repeated for at most 
\begin_inset Formula $5$
\end_inset

 recalculations and,
 at each recalculation,
 the interval is zoomed-in by a factor of 
\begin_inset Formula $4$
\end_inset

 and subdivided in 
\begin_inset Formula $101$
\end_inset

 points (an odd number is chosen to ensure that the best previous estimate belongs to the grid).
 
\end_layout

\begin_layout Itemize
For the cases where an asymptotic patching is implemented,
 
\begin_inset Formula $\tilde{U}_{t}$
\end_inset

 and its derivatives integrate to at most 
\begin_inset Formula $\tilde{U}_{t,max}=10'000$
\end_inset

 units.
 
\end_layout

\begin_layout Itemize
For runs in connection to the shooting method or the grid search method,
 normally initial conditions ranging from 
\begin_inset Formula $\sigma_{min}=-0.95$
\end_inset

 to 
\begin_inset Formula $\sigma_{max}=+0.95$
\end_inset

 in 
\begin_inset Formula $8'000$
\end_inset

 steps are used,
 although at times 
\begin_inset Formula $\sigma_{max}$
\end_inset

 is extended up to 
\begin_inset Formula $\sigma_{max}=2.50$
\end_inset

 and the numer of steps is extended to at most 
\begin_inset Formula $8'000$
\end_inset

 steps,
 if it is observed that the chosen interval doesn't encompass all the relevant multicritical points.
 For example,
 for 
\begin_inset Formula $d=2.05$
\end_inset

 and 
\begin_inset Formula $s=2$
\end_inset

,
 at least the tri-critical point lies between 
\begin_inset Formula $\sigma\in\left[2.00,2.50\right]$
\end_inset

,
 in which case additional sampling is required.
 
\end_layout

\begin_layout Itemize
For runs in connection to the 
\begin_inset Quotes eld
\end_inset

eigenperturbation method
\begin_inset Quotes erd
\end_inset

 (that is,
 the method for finding the RG eigenvalues by means of Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:13"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

)),
 we consider eigenvalues 
\begin_inset Formula $y\in\left[-3.00,+3.00\right]$
\end_inset

 to at most 
\begin_inset Formula $2'000$
\end_inset

 steps.
 The initial condition 
\begin_inset Formula $\sigma$
\end_inset

 and the anomalous dimension 
\begin_inset Formula $\eta$
\end_inset

 are chosen from the shooting method,
 and a subsequent grid search method in the vicinity of the input parameter (to a range of 
\begin_inset Formula $\pm10\%$
\end_inset

 of the input parameter) is executed to tune the values of 
\begin_inset Formula $\sigma,\eta$
\end_inset

,
 in order to improve convergence.
 Furthermore,
 in this case 
\begin_inset Formula $\eta$
\end_inset

 is treated as an independent variable as opposed to be calculated self-consistently from 
\begin_inset Formula $\sigma$
\end_inset

,
 as already discussed previusly.
 
\end_layout

